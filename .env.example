# Frontend API mode.
# mock = deterministic in-browser adapter (default, no backend required)
# http = Marco NestJS backend at VITE_MARCO_API_BASE
VITE_MARCO_API_MODE=mock
VITE_MARCO_API_BASE=/api

# Required by the real backend (x-user-id header). Mock mode ignores it.
VITE_MARCO_USER_ID=user_demo
